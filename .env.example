CESIUM_ION_TOKEN=
PORT=3001
# Optional for static GitHub Pages builds (no Express). Prefer a restricted client token.
# Token should allow the Cesium assets you use (imagery/terrain) and OSM Buildings if enabling「全球建筑」.
# When unset on Pages, the app stays on the built-in base globe (no hard failure).
# VITE_CESIUM_ION_TOKEN=
# Project Pages base path is set in CI as VITE_BASE=/3D-Earth/
# VITE_BASE=/
