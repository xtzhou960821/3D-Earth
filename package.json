    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "cesium": "1.145.0",
    "concurrently": "10.0.5",
    "dotenv": "17.4.2",
    "exifr": "7.1.3",
    "express": "5.2.1",
    "lucide-react": "1.41.0",
    "multer": "2.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "vite": "8.2.2",
    "vite-plugin-static-copy": "4.1.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
