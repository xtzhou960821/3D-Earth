+import test from "node:test";
+import assert from "node:assert/strict";
+import { getPanoramaPresentation } from "../src/lib/layerView.ts";
+
+test("derives an editable panorama marker from the latest layer values", () => {
+  assert.deepEqual(
+    getPanoramaPresentation({
+      name: "微调后的观景台",
+      longitude: 121.3824,
+      latitude: 28.6893,
+      height: 86.5,
+    }),
+    {
+      name: "微调后的观景台",
+      longitude: 121.3824,
+      latitude: 28.6893,
+      markerHeight: 90.5,
+    },
+  );
+});
diff --git a/server/photo-location.test.js b/server/photo-location.test.js
new file mode 100644
index 0000000..760c33a
--- /dev/null
+++ b/server/photo-location.test.js
@@ -0,0 +1,53 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs/promises";
+import { fileURLToPath } from "node:url";
+import {
+  normalizePhotoLocation,
+  readPhotoLocation,
+} from "../src/lib/photoLocation.ts";
+
+test("normalizes DJI EXIF GPS coordinates and altitude", () => {
+  assert.deepEqual(
+    normalizePhotoLocation({
+      latitude: 28.6892583333333,
+      longitude: 121.382286111111,
+      GPSAltitude: 82.9,
+    }),
+    {
+      latitude: 28.689258,
+      longitude: 121.382286,
+      height: 82.9,
+    },
+  );
+});
+
+test("keeps valid coordinates when altitude is absent", () => {
+  assert.deepEqual(
+    normalizePhotoLocation({ latitude: 31.2, longitude: 121.5 }),
+    { latitude: 31.2, longitude: 121.5 },
+  );
+});
+
+test("rejects missing and out-of-range GPS metadata", () => {
+  assert.equal(normalizePhotoLocation({}), null);
+  assert.equal(
+    normalizePhotoLocation({ latitude: 91, longitude: 121.5 }),
+    null,
+  );
+});
+
+const djiSample = fileURLToPath(
+  new URL("../720全景/DJI_20260911170527_0004_V.JPG", import.meta.url),
+);
+test(
+  "reads the GPS position from the supplied DJI panorama",
+  { skip: !(await fs.stat(djiSample).catch(() => null)) },
+  async () => {
+    const location = await readPhotoLocation(djiSample);
+    assert.ok(location);
+    assert.ok(Math.abs(location.latitude - 28.689258) < 0.000001);
+    assert.ok(Math.abs(location.longitude - 121.382287) < 0.000001);
+    assert.ok(Math.abs((location.height ?? 0) - 82.952) < 0.001);
+  },
+);
