diff --git a/src/lib/photoLocation.ts b/src/lib/photoLocation.ts
new file mode 100644
index 0000000..6ee0ec6
--- /dev/null
+++ b/src/lib/photoLocation.ts
@@ -0,0 +1,71 @@
+export interface PhotoLocation {
+  latitude: number;
+  longitude: number;
+  height?: number;
+}
+
+interface ExifGpsTags {
+  latitude?: unknown;
+  longitude?: unknown;
+  GPSAltitude?: unknown;
+  GPSAltitudeRef?: unknown;
+}
+
+function finiteNumber(value: unknown) {
+  return typeof value === "number" && Number.isFinite(value)
+    ? value
+    : undefined;
+}
+
+function altitudeIsBelowSeaLevel(value: unknown) {
+  if (value instanceof Uint8Array) return value[0] === 1;
+  return value === 1;
+}
+
+export function normalizePhotoLocation(
+  tags: ExifGpsTags | null | undefined,
+): PhotoLocation | null {
+  const latitude = finiteNumber(tags?.latitude);
+  const longitude = finiteNumber(tags?.longitude);
+  if (
+    latitude === undefined ||
+    longitude === undefined ||
+    latitude < -90 ||
+    latitude > 90 ||
+    longitude < -180 ||
+    longitude > 180
+  )
+    return null;
+
+  const altitude = finiteNumber(tags?.GPSAltitude);
+  const result: PhotoLocation = {
+    latitude: Number(latitude.toFixed(6)),
+    longitude: Number(longitude.toFixed(6)),
+  };
+  if (altitude !== undefined) {
+    const signedAltitude = altitudeIsBelowSeaLevel(tags?.GPSAltitudeRef)
+      ? -Math.abs(altitude)
+      : altitude;
+    result.height = Number(signedAltitude.toFixed(3));
+  }
+  return result;
+}
+
+export async function readPhotoLocation(
+  source: Blob | ArrayBuffer | Uint8Array | string,
+): Promise<PhotoLocation | null> {
+  try {
+    const { default: exifr } = await import("exifr");
+    const tags = (await exifr.parse(source, [
+      "GPSLatitude",
+      "GPSLongitude",
+      "GPSLatitudeRef",
+      "GPSLongitudeRef",
+      "GPSAltitude",
+      "GPSAltitudeRef",
+    ])) as ExifGpsTags | undefined;
+    return normalizePhotoLocation(tags);
+  } catch {
+    return null;
+  }
+}
